#
# spec file for package gptray
#
# Generated by packaging/obs/obs-release.sh; edit the .in template.
#

Name:           gptray
Version:        @VERSION@
Release:        0
Summary:        Tray GUI for GlobalProtect-openconnect (VIBE CODED, use at your own risk)
License:        GPL-3.0-only
Group:          Productivity/Networking/Other
URL:            https://github.com/afonsusousa/GlobalProtect-openconnect
Source0:        %{name}-%{version}.tar.gz
# Vendored crates: OBS builds without network access.
Source1:        vendor.tar.xz

ExclusiveArch:  x86_64 aarch64

BuildRequires:  cargo >= 1.91
BuildRequires:  rust >= 1.91
BuildRequires:  gcc
BuildRequires:  pkgconfig
BuildRequires:  pkgconfig(dbus-1)
BuildRequires:  pkgconfig(gtk+-3.0)
BuildRequires:  pkgconfig(javascriptcoregtk-4.1)
BuildRequires:  pkgconfig(libsoup-3.0)
BuildRequires:  pkgconfig(librsvg-2.0)
BuildRequires:  pkgconfig(openssl)
BuildRequires:  pkgconfig(webkit2gtk-4.1)
BuildRequires:  hicolor-icon-theme
BuildRequires:  desktop-file-utils

# gpservice only accepts clients built for its exact release. The BuildRequires makes
# OBS report "unresolvable" (instead of publishing a broken package) once upstream
# (home:yuezk) moves to a release this gptray wasn't built for. The version is the
# tag gpapi is pinned to in src-tauri/Cargo.toml.
BuildRequires:  globalprotect-openconnect = @GP_VERSION@
Requires:       globalprotect-openconnect = @GP_VERSION@
Requires:       (libayatana-appindicator3-1 or libappindicator3-1)

%global debug_package %{nil}

%description
*** WARNING: THIS IS VIBE CODED ***
This software was written almost entirely by an AI coding assistant (Claude)
with minimal human review. It handles VPN sign-in credentials and drives a
privileged (root) service. It has not been audited. Use it at your own risk;
there is no warranty of any kind.

gptray is a free (GPL-3.0) tray icon and compact connection window for
GlobalProtect-openconnect. It drives the open-source gpservice and gpclient:
gpservice is started through the packaged polkit policy without a password
prompt, sign-in (built-in SAML window, system browser or password) runs
unprivileged through gpclient, and the sign-in is remembered per connection.

%prep
# vendor/ lands next to src-tauri/; the tarball's src-tauri/.cargo/config.toml points there.
%setup -q -a1

%build
# The injected RUSTFLAGS could fail the build
unset RUSTFLAGS
cd src-tauri
cargo build --release --offline --locked

%install
install -Dm755 src-tauri/target/release/gptray %{buildroot}%{_bindir}/gptray
install -Dm644 packaging/gptray.desktop %{buildroot}%{_datadir}/applications/gptray.desktop
install -Dm644 src-tauri/icons/32x32.png %{buildroot}%{_datadir}/icons/hicolor/32x32/apps/gptray.png
install -Dm644 src-tauri/icons/128x128.png %{buildroot}%{_datadir}/icons/hicolor/128x128/apps/gptray.png
install -Dm644 src-tauri/icons/icon.png %{buildroot}%{_datadir}/icons/hicolor/256x256/apps/gptray.png

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/gptray.desktop

%files
%license LICENSE
%doc README.md
%{_bindir}/gptray
%{_datadir}/applications/gptray.desktop
%{_datadir}/icons/hicolor/*/apps/gptray.png

%changelog
