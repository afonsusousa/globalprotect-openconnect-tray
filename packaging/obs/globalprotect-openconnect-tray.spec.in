#
# spec file for package globalprotect-openconnect-tray
#
# Generated by packaging/obs/obs-release.sh; edit the .in template.
#

%global gp_version @GP_VERSION@

Name:           globalprotect-openconnect-tray
Version:        @VERSION@
Release:        0
Summary:        GlobalProtect VPN client with a tray GUI (VIBE CODED, use at your own risk)
# Tray: GPL-3.0-only. Bundled upstream components: GPL-3.0 (gpclient, gpservice,
# gpauth), MIT (gpapi, common and other crates), LGPL-2.1+ (OpenConnect, libxml2 is MIT).
License:        GPL-3.0-only AND MIT AND LGPL-2.1-or-later
Group:          Productivity/Networking/Other
URL:            https://github.com/afonsusousa/GlobalProtect-openconnect
# The tray, with its prebuilt frontend and cargo vendor config.
Source0:        %{name}-%{version}.tar.gz
# Crates for the tray (OBS builds offline).
Source1:        vendor.tar.xz
# Upstream GlobalProtect-openconnect at the pinned tag, from `make tarball OFFLINE=1`
# (sources, OpenConnect/libxml2 submodules and vendored crates).
Source2:        globalprotect-openconnect-%{gp_version}.tar.gz

ExclusiveArch:  x86_64 aarch64

# Upstream components (see upstream's packaging/rpm spec)
BuildRequires:  autoconf
BuildRequires:  automake
BuildRequires:  cargo >= 1.91
BuildRequires:  file
BuildRequires:  gcc-c++
BuildRequires:  gettext
BuildRequires:  gmp-devel
BuildRequires:  gnutls-devel
BuildRequires:  libtool
BuildRequires:  libxml2-devel
BuildRequires:  make
BuildRequires:  p11-kit-devel
BuildRequires:  perl
BuildRequires:  pkgconfig
BuildRequires:  rust >= 1.91
BuildRequires:  wget
BuildRequires:  zlib-devel
BuildRequires:  (lz4-devel or liblz4-devel)
BuildRequires:  (nettle-devel or libnettle-devel)
BuildRequires:  (openssl-devel or libopenssl-devel)
# WebKitGTK: gpauth's embedded sign-in window and the tray
BuildRequires:  pkgconfig(dbus-1)
BuildRequires:  pkgconfig(gtk+-3.0)
BuildRequires:  pkgconfig(javascriptcoregtk-4.1)
BuildRequires:  pkgconfig(libsoup-3.0)
BuildRequires:  pkgconfig(librsvg-2.0)
BuildRequires:  pkgconfig(webkit2gtk-4.1)
BuildRequires:  desktop-file-utils
BuildRequires:  hicolor-icon-theme

Requires:       polkit
Requires:       xdg-utils
Requires:       (libayatana-appindicator3-1 or libappindicator3-1)
# Ships the same gpclient/gpservice/gpauth files as upstream's package.
Conflicts:      globalprotect-openconnect
Conflicts:      globalprotect-openconnect-snapshot
Provides:       globalprotect-openconnect-cli = %{gp_version}
# Former name of the tray package.
Obsoletes:      gptray < %{version}
Provides:       gptray = %{version}

%global debug_package %{nil}

%description
*** WARNING: THIS IS VIBE CODED ***
The tray app was written almost entirely by an AI coding assistant (Claude)
with minimal human review. It handles VPN sign-in credentials and drives a
privileged (root) service. It has not been audited. Use it at your own risk;
there is no warranty of any kind.

A GlobalProtect VPN client: the open-source components of GlobalProtect-openconnect
%{gp_version} (gpclient, gpservice, gpauth, built from source without the
proprietary GUI), plus a free tray icon and compact connection window that drives
them. gpservice is started through the packaged polkit policy without a password
prompt, sign-in (built-in SAML window, system browser or password) runs
unprivileged through gpclient, and the sign-in is remembered per connection.

%prep
# The tray: vendor/ lands next to src-tauri/, whose .cargo/config.toml points there.
%setup -q -a1
# Upstream, unpacked into ./globalprotect-openconnect-%{gp_version}/
%setup -q -T -D -a2

%build
# The injected RUSTFLAGS could fail the build
unset RUSTFLAGS
# Upstream: gpclient, gpservice, gpauth (+ helpers). No proprietary GUI, no GUI helper.
make -C globalprotect-openconnect-%{gp_version} build OFFLINE=1 INCLUDE_GUI=0 BUILD_GUI_HELPER=0
# The tray
cd src-tauri
cargo build --release --offline --locked

%install
make -C globalprotect-openconnect-%{gp_version} install DESTDIR=%{buildroot} PREFIX=%{_prefix} \
  OFFLINE=1 INCLUDE_GUI=0 BUILD_GUI_HELPER=0
# Upstream's desktop entry launches the proprietary GUI, which isn't included.
rm -f %{buildroot}%{_datadir}/applications/gpgui.desktop

install -Dm755 src-tauri/target/release/%{name} %{buildroot}%{_bindir}/%{name}
install -Dm644 packaging/%{name}.desktop %{buildroot}%{_datadir}/applications/%{name}.desktop
install -Dm644 src-tauri/icons/32x32.png %{buildroot}%{_datadir}/icons/hicolor/32x32/apps/%{name}.png
install -Dm644 src-tauri/icons/128x128.png %{buildroot}%{_datadir}/icons/hicolor/128x128/apps/%{name}.png
install -Dm644 src-tauri/icons/icon.png %{buildroot}%{_datadir}/icons/hicolor/256x256/apps/%{name}.png

mkdir -p upstream-licenses
cp globalprotect-openconnect-%{gp_version}/LICENSE upstream-licenses/LICENSE.GPL-3.0
for crate in gpapi common openconnect; do
  cp globalprotect-openconnect-%{gp_version}/crates/$crate/LICENSE upstream-licenses/LICENSE.$crate 2>/dev/null || :
done
cp globalprotect-openconnect-%{gp_version}/crates/openconnect/deps/openconnect/COPYING.LGPL upstream-licenses/ 2>/dev/null || :

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/%{name}.desktop

%postun
if [ "$1" -eq 0 ]; then
    rm -f /var/lib/gpclient/gpgui \
        /var/lib/gpclient/scripts/vpnc-script \
        /var/lib/gpclient/scripts/vpnc-script.metadata || :
    rmdir /var/lib/gpclient/scripts 2>/dev/null || :
    rmdir /var/lib/gpclient 2>/dev/null || :
fi

%files
%license LICENSE upstream-licenses/*
%doc README.md
%{_bindir}/%{name}
%{_bindir}/gpclient
%{_bindir}/gpservice
%{_bindir}/gpauth
%dir %{_libexecdir}/gpclient
%{_libexecdir}/gpclient/vpnc-script
%{_libexecdir}/gpclient/gp-hip-script-installer
%{_libexecdir}/gpclient/gp-vpnc-script-installer
%{_datadir}/applications/%{name}.desktop
%{_datadir}/icons/hicolor/*/apps/%{name}.png
%{_datadir}/icons/hicolor/*/apps/gpgui.*
%{_datadir}/icons/hicolor/scalable/status/gpgui-*.svg
%dir %{_datadir}/icons/hicolor/256x256@2
%dir %{_datadir}/icons/hicolor/256x256@2/apps
%dir %{_datadir}/polkit-1
%dir %{_datadir}/polkit-1/actions
%{_datadir}/polkit-1/actions/com.yuezk.gpgui.policy
%dir /usr/lib/NetworkManager
%dir /usr/lib/NetworkManager/dispatcher.d
%dir /usr/lib/NetworkManager/dispatcher.d/pre-down.d
/usr/lib/NetworkManager/dispatcher.d/pre-down.d/gpclient.down
/usr/lib/NetworkManager/dispatcher.d/gpclient-nm-hook

%changelog
