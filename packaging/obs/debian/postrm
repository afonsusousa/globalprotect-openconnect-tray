#!/bin/sh
set -e
if [ "$1" = "purge" ] || [ "$1" = "remove" ]; then
    rm -f /var/lib/gpclient/gpgui \
        /var/lib/gpclient/scripts/vpnc-script \
        /var/lib/gpclient/scripts/vpnc-script.metadata || true
    rmdir /var/lib/gpclient/scripts 2>/dev/null || true
    rmdir /var/lib/gpclient 2>/dev/null || true
fi
#DEBHELPER#
